shadow></value><value name="label"><shadow type="text" id="moRHo`3Lw$$==1_Pr1K!"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id=".s{CAR:6vq?5$~eEp/#n"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="Y1=xcNd{d+0)@)/gcQ*@"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="uQ_fbNfoH2*6(CnKguDa"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id=",VP46t|;3*quqOgR5{-K"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="Zx^*;]Wg7IJ4kSboKl@e"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="*L_%,|drp#UfP^eDP(PG"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="AhVkmN}Ick)}@[*y(PnQ"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="uv!fVcGHDX}J6WqDN7lG"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="9%TQ!MuPQ:S4_p-q!AtE"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="F5An[d.Bm?2M3#v!!x-S"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="#SuGwj4f5-g]J{mWH^o~"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="}ORK-r_3]0#dX7K{[3Y2"><field name="TEXT">You</field></shadow></value><next><block type="function_call" id="PzDW!#7FV/|P7z1-e[{d"><mutation name="scrambleCharacterName" functionid="MPcdw2U$!JeZ}/S938kU"><arg name="name" id="726kf6trwsy6x3a86rhk" type="string"></arg></mutation><value name="726kf6trwsy6x3a86rhk"><shadow t