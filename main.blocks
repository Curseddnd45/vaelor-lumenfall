shadow></value><value name="label"><shadow type="text" id="43xF)s%mcE]C4(EI7-5*"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id=",T^5kWWW-}@O)qK#Eu[w"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="V7n+8,[MA#{7CE.Y8Yen"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="p%2[;VU8=2mLh7e=Baz8"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="dCi~8^nIu?$k^T(o`AXN"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="1I2?a$0{iclX(YXS%dmD"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="P~qZ:09i~2jil@C.Ebi]"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="0K?UGOioOF{}AW=L44!u"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="J=hGqwGvFfIyD9KVB+V*"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="X,xS4AAq$giSr].lU~:~"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="3LqF,u|7`3C,6fGpL[fG"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="_k_G:oC|PY0]Lss-Fb{+"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="_fC%k=%BpG}qm$)%sNu2"><field name="TEXT">You</field></shadow></value><next><block type="function_call" id="E:{i](J}hHk:rVQ-/R^0"><mutation name="scrambleCharacterName" functionid="$Dx+BtA[,j}Yr6jq}E=N"><arg name="name" id="i8banmfea3q10xjlghlo" type="string"></arg></mutation><value name="i8banmfea3q10xjlghlo"><shadow t