JqLVf"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="QHtY-=en62Magfp(EIG)"><field name="TEXT">Hello?</field></shadow></value><value name="label"><shadow type="text" id="|PC(+PwieyFuOf]Csb:M"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="1B+O}Qt={#]Jr~#K*FP?"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="Jms6]cD(_GoElylnX`g~"><field name="TEXT">Helloooo?</field></shadow></value><value name="label"><shadow type="text" id="SuP#l.^R?UU)WvHk|,t/"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id=";|CifS73a7H@~t^=LQqq"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="QN}.5ANg98a%.;fZVYgR"><field name="TEXT">Vae?</field></shadow></value><value name="label"><shadow type="text" id="KeeGrYCIM4gPj0`;~1*j"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="BBL#tg-D=1QT=C7biCwx"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="MhpFz^4afq:DE|dRkXi["><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="2AzXDA@qb{cOvJ)tR]1A"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="ki#Gqi(JT8,raxk~q[?m"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="-oK;W+FDI:w0Dn]%O]Nu"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="9AL*zp0mp3Y|K_wpd/?="><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_tex