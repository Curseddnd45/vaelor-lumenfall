shadow></value><value name="label"><shadow type="text" id="aKd12dT3Mw$n|zysOUA,"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="8{m5qF;X*%WHkp$jEELT"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="8gJ;{e|(59~uQG{^0_^Z"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id=";t1A69;*-;`VE/1.6,aa"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id=";Lqzcc(ONM[qN8lXM!qp"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="nJzk-X1u/Mxk4@.U9;|X"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="ryd^vCy^4O{DZtc7~vW_"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="(IvofNMY/Ag`Dv9g]#Ce"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="YgFbQPCofS$CxgUd_2-H"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="(9VdO!4ZKQ.0.)/lB+9Z"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="gU{W]|[-l[(NV[l/Q0~9"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="$a3b8$loD=1fMuRqjJ(s"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="/nv%~[S1k6!CJZjgMN`("><field name="TEXT">You</field></shadow></value><next><block type="function_call" id="29(m$A`nQD.H8|Wo^%Oj"><mutation name="scrambleCharacterName" functionid=".GZ=p?Af|cbQ9/E+PT2M"><arg name="name" id="8r00gun8oe4pvtc7mrk7x" type="string"></arg></mutation><value name="8r00gun8oe4pvtc7mrk7x"><shadow type="text" id="[x,7N?[d{[?.?`_NTwAc"><field name="TEXT">Lyra</field></shadow></value><next><block type="arcade_story_print_character_text" id="+zg%rfx0im7;`3}Qm3%@"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="t7+QTA/~au0U|JZiUJf4"><field name="TEXT">Well then, come on out!</field></shadow></value><value name="label"><shadow type="text" id="nC9qp?n}X):uD2St%3g5"><field name="TEXT">Lyra</field></shadow></value><next><block type="arcade_story_print_character_text" id="9y+qhA[~HBk9FVauENnu"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="-:-^%Y:}|1(`N7sN3bdy"><field name="TEXT">We need your help!</field></shadow></value><value name="label"><shadow type="text" id="W7={(U~0t4YuL;csty!j"><field name="TEXT">Lyra</field></shadow></value><next><block type="game_control_sprite" id="b[62~Z[U*dT[-6ON7r6b"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="9b;7^+K.`C1-g*P7N?0K"><field name="VAR" id="cv-F?Ip33Tft:16gkozs">playerSprite</field></block></value><next><block type="variables_set" id="RO/WW[qFsTpOf5QATePH"><field name="VAR" id="dxQ5JkG!h*mFQ~%`2ak=">dialogueActive</field><value name="VALUE"><shadow type="math_number" id="XW$@|hSOCJz3`/8%wTkz"><field name="NUM">0</field></shadow><block type="logic_boolean" id="IQ:TW=cAbxP#=%[%O+oU"><field name="BOOL">FALSE</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></