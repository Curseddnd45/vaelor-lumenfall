shadow></value><value name="label"><shadow type="text" id="VZ~!i;/%mr?t@(oej,[;"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="]SMI)Z4UMnX+qNt*7gVe"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="!K7O6nQT`]siXb2c)s1f"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="x3zG]X:,+m@aK,F_`8--"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="]DQ$[I#Da7|n|tS_MlTo"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="FZgkHI)*qT9W+S_SSkZU"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="C^K~vtogYBRWtabQ/jPR"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="rk[xtd2|m@QkT:Bt:@7j"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="IVrt46y_U]@Cm~6XJS6A"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="ayoXu+o@B^(nh3xoSl*9"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="$|Mzh^{ZkfW+061Y,+Sb"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="ErvDzf2jnUl13;H)ydya"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="JaL,SEld0h}*G.Y:J@I,"><field name="TEXT">You</field></shadow></value><next><block type="function_call" id=",}~#dfCj/`.62ESqzE$d"><mutation name="scrambleCharacterName" functionid="A)e#il#N*(PcjDdzt6tK"><arg name="name" id="fbmk4ekx1md467fen8o5" type="string"></arg></mutation><value name="fbmk4ekx1md467fen8o5"><shadow t