%e;J_"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="KtE)6_QZ{AaH!A$TJe!%"><field name="TEXT">Hello?</field></shadow></value><value name="label"><shadow type="text" id="5H6Z,]~Sw1in6Yj9fd!q"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="~TH(2!jaz?x2OLwT6RUB"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="ZrXy=M}=3G*c~h~)*z[m"><field name="TEXT">Helloooo?</field></shadow></value><value name="label"><shadow type="text" id=",kQ4?2in}e9Ld9%GW_h6"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="I#{2~-:SX7hXkQ;rna-H"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="bvN.Chp#-ko@d{_E:Z^9"><field name="TEXT">Vae?</field></shadow></value><value name="label"><shadow type="text" id="aO~64v|Vp*Kr*Pys|j%2"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="xuhMsLa+li%T}65aP})O"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="Syga-f=-d|Fa/=9yt?C5"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="H7TTN(b5}}N64S{y,150"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="V=eRN~)#G2-;Nj1ub;F0"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="/9Kg/,#.ORkv[?{%@d8R"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="E}(3dGEOK*!U@m3%zg8X"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_tex