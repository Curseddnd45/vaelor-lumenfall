shadow></value><value name="label"><shadow type="text" id="a+OB5)$2_l7DP-oh3!6K"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="IOT{lLJo{MYAPSJj#Ee!"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="yS3q!o.rg%_5=FP9~GpW"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="t`y3p}-=#E^ewod1QuRh"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="aXK$F1CV/A*=J6^U~sRk"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="Nk`nhD`aJQB]tKIUgOL6"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="_^Vv2f$rz`G/[^Q,6qg#"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="VL[8M9vL}n|~U43)Xm3m"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="ILZy(LHtw`*#vv}JI~k#"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="vob)ydgt8fSS$=aC=.]%"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="80xM$v81e3eVUCX)(goJ"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="s+q7#B2xlx|~Vn)I/kiW"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="OOE^N?%)+vc$G[5yfo;G"><field name="TEXT">You</field></shadow></value><next><block type="function_call" id="8US$_O)-CXcGIEMUDp2`"><mutation name="scrambleCharacterName" functionid="o%X2/?uEd?8ks/h{B[47"><arg name="name" id="4edhvmjzva4qnzqhuqgz" type="string"></arg></mutation><value name="4edhvmjzva4qnzqhuqgz"><shadow type="text" id="qaPo`vY*GRdfvUhx#hVf"><field name="TEXT">Lyra</field></shadow></value><next><block type="arcade_story_print_character_text" id="))o]2;f%9CZ7LxQ701qE"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="L?6szG9a5@f0sOPd$Zzq"><field name="TEXT">Well then, come on out!</field></shadow></value><value name="label"><shadow type="text" id="LP.aEuNum/f9S?35@9=c"><field name="TEXT">Lyra</field></shadow></value><next><block type="arcade_story_print_character_text" id="EV2e%8GKnw=tmZ{lM)d%"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="34J6{k6p~K8x;DNip/N?"><field name="TEXT">We need your help!</field></shadow></value><value name="label"><shadow type="text" id=",+9W+~BlFrp7,w@J0#Hv"><field name="TEXT">Lyra</field></shadow></value><next><block type="game_control_sprite" id="pHr3pCY*Q4fWJ]f*Rx#a"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="k?H_Jj=53LFu?vXWVt2J"><field name="VAR" id="{zI9bLL-tj-a*8@BiEs^">playerSprite</field></block></value><next><block type="variables_set" id=")EfRE6o3,(`amjap|`)M"><field name="VAR" id="6WD#L@*ZQ3#^^XcuR40t">dialogueActive</field><value name="VALUE"><shadow type="math_number" id="$`}IrPiNQTSYer,w^he?"><field name="NUM">0</field></shadow><block type="logic_boolean" id="6yOmWGSEPnr0zp,NLmtm"><field name="BOOL">FALSE</field></block></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></ne