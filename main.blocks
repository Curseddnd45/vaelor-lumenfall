shadow></value><value name="label"><shadow type="text" id="fmjwgee:|/s:|{1j~uY+"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="5QmOL0L7_6HKpsfA9aHD"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="p{ZiRAa}]$|fyuhylixl"><field name="TEXT">You awake?</field></shadow></value><value name="label"><shadow type="text" id="+u,PF0kVO{N`9H~Z]/6s"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="b.ADlrl@F?vXuFA$*Rp#"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="_*7;q}_1IU~alp5{s;#}"><field name="TEXT">*yawn* yes. Wait, who is it?</field></shadow></value><value name="label"><shadow type="text" id="ZhhTiVgn3pVyw%Dv,Y^5"><field name="TEXT">You</field></shadow></value><next><block type="arcade_story_print_character_text" id="I3_D}4C~BRCvn%cTyE|."><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="IUbu.NwQ/Cm!g!nkM;(p"><field name="TEXT">Me!</field></shadow></value><value name="label"><shadow type="text" id="dGY9,RbPZ/)3gOtRO%BI"><field name="TEXT">???</field></shadow></value><next><block type="arcade_story_print_character_text" id="3I3crh;}!3L^^.P~[deg"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="text"><shadow type="text" id="SI}ACbdgEDs3,MXk1MA0"><field name="TEXT">Oh, hey!</field></shadow></value><value name="label"><shadow type="text" id="w;FA@u/mqemS:!nml=$A"><field name="TEXT">You</field></shadow></value><next><block type="function_call" id=";w=WM;U!;}YtQ[?9Do=V"><mutation name="scrambleCharacterName" functionid="Z,JY|Jce)GVnDn2~3fTu"><arg name="name" id="81n4xpkc4m6puup1azk2" type="string"></arg></mutation><value name="81n4xpkc4m6puup1azk2"><shadow t